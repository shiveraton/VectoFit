# Server only: /etc/vectofit/backend.env, root:vectofit mode 0640.
SECRET_KEY=REPLACE_WITH_RANDOM_DJANGO_SECRET
ANNOTATOR_INVITATION_CODE=REPLACE_WITH_RANDOM_INVITATION_SECRET
DEBUG=False
ALLOWED_HOSTS=annotator.example.org,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://annotator.example.org,http://localhost:8080
CSRF_TRUSTED_ORIGINS=https://annotator.example.org,http://localhost:8080
DATABASE_URL=postgresql://vectofit:REPLACE_PASSWORD@127.0.0.1:5432/vectofit
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
MEDIA_ROOT=/srv/vectofit/data/media
STATIC_ROOT=/srv/vectofit/data/static
SECURE_SSL_REDIRECT=True
