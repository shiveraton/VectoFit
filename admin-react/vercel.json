{
  "buildCommand": "npm run build:public",
  "outputDirectory": "dist-public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/annotator/:path*/",
      "destination": "https://vectofit.onrender.com/api/annotator/:path*/"
    },
    {
      "source": "/api/annotator/:path*",
      "destination": "https://vectofit.onrender.com/api/annotator/:path*/"
    },
    { "source": "/", "destination": "/index.html" },
    { "source": "/annotator", "destination": "/index.html" },
    { "source": "/annotator/:path*", "destination": "/index.html" }
  ]
}
